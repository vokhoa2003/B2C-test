{
  "name": "b2c-test",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:chromium": "playwright test --project=chromium",
    "report": "playwright show-report",
    "install:browsers": "playwright install",
    "clean": "node -e \"require('fs').rmSync('test-results',{recursive:true,force:true});require('fs').rmSync('playwright-report',{recursive:true,force:true})\"",
    "compare:metasearch": "node scripts/compare-metasearch.js",
    "compare:metasearch:headed": "node scripts/compare-metasearch.js --headed",
    "compare:metasearch:clear": "node scripts/compare-metasearch.js --clear-history",
    "compare:metasearch:reports": "node scripts/metasearch-reports.js",
    "compare:metasearch:review": "node scripts/compare-metasearch.js --review",
    "compare:metasearch:open": "node scripts/metasearch-reports.js --live"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "dotenv": "^18.0.6"
  },
  "packageManager": "yarn@4.18.0+sha512.fcb8716fe7cd0eece141ffc18b92193a9df9204c1ba83189c288835223fc0bbe64af473bab0d5e9927a7daeb5caf2bb07eb2787cc9338ca040ea125f2a1f2f7e"
}

# URL gốc của app traveleasy-web-user cần test
BASE_URL=http://localhost:3000

# Đặt true nếu muốn Playwright tự động chạy "yarn dev" ở ../traveleasy-web-user trước khi test
START_WEB_SERVER=false

# Tài khoản dùng cho test đăng nhập (tự tạo sẵn ở môi trường dev, không dùng tài khoản thật)
TEST_USER_EMAIL=
TEST_USER_PASSWORD=

# URL gốc của app traveleasy-web-user cần test
BASE_URL=http://localhost:3000

# Đặt true nếu muốn Playwright tự động chạy "yarn dev" ở ../traveleasy-web-user trước khi test
START_WEB_SERVER=false

# Tài khoản dùng cho test đăng nhập (tự tạo sẵn ở môi trường dev, không dùng tài khoản thật)
TEST_USER_EMAIL=
TEST_USER_PASSWORD=

# Tool so sánh metasearch đối tác vs web gốc (tests/metasearch/metasearch-vs-web.spec.ts)
META_API_URL=https://api-dev.triphubs.vn
META_COMPARE_WEB_URL=https://dev.triphubs.vn
META_CLIENT_ID=
META_USERNAME=
META_PASSWORD=

# Lấy dữ liệu web bằng cách gọi thẳng API /flights/search/ (thay vì bắt qua browser — response lớn như
# GALILEO_NDC ~10 MB browser không đọc được). Token: DevTools → Network → request flights/search →
# Request Headers → authorization (bỏ "Bearer "). Bỏ trống = bắt qua browser như cũ.
WEB_API_URL=https://api-dev.triphubs.vn
WEB_API_TOKEN=
# Hoặc để tool tự đăng nhập lấy token (POST /auth/login, giống web: NEXT_PUBLIC_AUTHEN_API_CLIENT_ID / USER / PASS).
# Dùng khi WEB_API_TOKEN bỏ trống.
WEB_API_CLIENT_ID=
WEB_API_USERNAME=
WEB_API_PASSWORD=
